{
  "name": "shopify-amazon-publisher",
  "version": "1.0.0",
  "description": "Publicar productos de Shopify a Amazon SP-API con IA para completar campos",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "publish:test": "node dist/scripts/publish-test.js",
    "check:sku": "node dist/scripts/check-sku.js",
    "search:amazon": "node dist/scripts/search-amazon.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "@shopify/shopify-api": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0"
  }
}
